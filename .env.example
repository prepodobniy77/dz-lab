# Внешний исполнитель. Один и тот же случайный секрет в Cloudflare и GitHub Actions.
PRICE_JOB_TOKEN=
SITE_URL=https://dz-lab.dimkaaistov.workers.dev
# Два цикла в сутки: 06:00 и 18:00 МСК. Защитный интервал полных циклов — 11 часов.
MIN_SWEEP_INTERVAL_MINUTES=660
# Максимум на весь цикл; без замеров выше 50 не увеличивать.
AI_MAX_PRODUCTS_PER_RUN=50
# Необязательный платный добор. Ключи только на сервере.
ROUTERAI_API_KEY=
ROUTERAI_MODEL=z-ai/glm-5.3-flash
PERPLEXITY_API_KEY=
PRICE_AI_MODEL=
# Необязательный официальный прайс поставщика; нужен разрешённый сервер/IP.
DELECT_API_KEY=
DELECT_DISTRIBUTOR=
# Необязательные уведомления. Если оба секрета не заданы, отправки нет.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Подтверждённый владелец MCP в Sites. Не доверять заголовкам вне доверенного прокси.
PRICE_JOB_OWNER_EMAIL=
TRUST_OAI_HEADERS=0
# Отображение технических панелей не заменяет серверную проверку владельца.
NEXT_PUBLIC_SHOW_ADMIN=0
