import {readdirSync,readFileSync,writeFileSync} from 'node:fs';
import {join} from 'node:path';

/** Build-time discovery only: no filesystem access in the deployed Worker. */
export function generatePriceProviders(directory:string) {
 const files=readdirSync(directory).filter(f=>f.endsWith('.ts')&&!['types.ts','index.ts'].includes(f)).sort();
 const content='// Generated by scripts/generate-price-providers.mts; edit an adapter instead.\n'+
  "import type {PriceProvider} from './types.ts';\n"+
  files.map((file,i)=>`import provider${i} from './${file}';`).join('\n')+
  `\nexport const providers:PriceProvider[] = [${files.map((_,i)=>'provider'+i).join(',')}];\n`+
  "export type {PriceProvider,ProviderContext,OfferBatch,SourceKind} from './types.ts';\n";
 const output=join(directory,'index.ts');
 let old='';try{old=readFileSync(output,'utf8')}catch{}
 if(old!==content)writeFileSync(output,content);
}
