import {readFile,writeFile} from 'node:fs/promises';import {fetchHtml,parseDetails,clean} from '../lib/providers.mts';import type {CatalogData} from '../lib/catalog-types';
const d:CatalogData=JSON.parse(await readFile('data/catalog.json','utf8'));const jobs=d.products.filter(p=>['hdd','aio'].includes(p.category));let done=0,stopped=false;const report:unknown[]=[];
async function work(){while(jobs.length&&!stopped){const p=jobs.shift()!;try{const html=await fetchHtml(p.offers.find(o=>o.store==='XCOM')!.url);Object.assign(p,parseDetails(html,p));const part=html.match(/class="card-(?:content-short-desc|sticky)-code__item"[^>]*>(Артикул:[\s\S]*?)<\/div>/i)?.[1];if(part)p.mpn=clean(part).replace(/^Артикул:\s*/i,'').trim();report.push({id:p.id,mpn:p.mpn,attributes:Object.keys(p.attributes||{}).length});}catch(e){report.push({id:p.id,error:String(e)});if(/HTTP (401|403|429)/.test(String(e)))stopped=true}done++;if(done%25===0)console.log('DETAILS',done);await new Promise(r=>setTimeout(r,300));}}
await Promise.all([work(),work()]);await writeFile('data/catalog.json',JSON.stringify(d,null,2));await writeFile('data/storage-cooling-report.json',JSON.stringify({checkedAt:new Date().toISOString(),done,stopped,report},null,2));console.log('DETAILS FINAL',done,'stopped',stopped);
