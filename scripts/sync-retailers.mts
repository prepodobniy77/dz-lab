import {readFile,writeFile} from 'node:fs/promises';
import {fetchHtml,parseOffer,parseRegardGoods,matchesMpn,clean} from '../lib/providers.mts';
import {stores,type StoreId} from '../lib/stores.ts';
import type {CatalogData,Offer,Product} from '../lib/catalog-types';
const data:CatalogData=JSON.parse(await readFile('data/catalog.json','utf8'));const compdayOnly=process.argv.includes('--compday-only');const report:{store:string;url:string;status:string;matched?:number;error?:string}[]=compdayOnly?JSON.parse(await readFile('data/retailer-sync-report.json','utf8')).report:[];
function attach(product:Product,offer:Offer){product.offers=product.offers.filter(o=>o.store!==offer.store);product.offers.push(offer)}
const normalize=(s:string)=>s.replace(/\s/g,'').toUpperCase();
const regardCategories=['1001/processory','1000/materinskie-platy','1013/videokarty','1010/operativnaya-pamyat','1015/nakopiteli-ssd','1225/bloki-pitaniya','5162/kulery-dlya-processorov','1032/korpusa'];
const pages=regardCategories.flatMap(path=>[1,2].map(page=>'https://www.regard.ru/catalog/'+path+(page>1?'?page='+page:'')));
async function regardWorker(){while(pages.length){const url=pages.shift()!;try{const html=await fetchHtml(url);const entries=parseRegardGoods(html);let matched=0;for(const entry of entries){for(const p of data.products.filter(p=>p.mpn&&normalize(p.mpn)===normalize(entry.mpn))){attach(p,{store:'REGARD',url:entry.url,price:entry.price,availability:entry.availability,checkedAt:new Date().toISOString(),status:'ok',identity:'mpn'});matched++}}report.push({store:'REGARD',url,status:'ok',matched});console.log('REGARD',matched,url)}catch(e){report.push({store:'REGARD',url,status:'error',error:String(e)});console.log('REGARD',String(e));if(/HTTP (401|403|429)/.test(String(e)))pages.splice(0)}}}
if(!compdayOnly)await regardWorker();
const links: {mpn:string;store:StoreId;url:string;referenceVerified?:boolean}[]=JSON.parse(await readFile('data/retailer-links.json','utf8')).filter((l:{store:string})=>!compdayOnly||l.store==='COMPDAY');
// Discover CPU links from CompDay's own product-list names, then verify the exact MPN on the detail page.
try{const html=await fetchHtml('https://www.compday.ru/komplektuyuszie/protsessory/');const seen=new Set(links.map(l=>l.url));for(const m of html.matchAll(/<a\b[^>]*href="([^"]*\/protsessory\/\d+\.htm)"[^>]*>([\s\S]*?)<\/a>/gi)){const name=clean(m[2]);if(!/OEM/i.test(name))continue;const url=new URL(m[1],'https://www.compday.ru').href;if(seen.has(url))continue;const p=data.products.find(p=>p.category==='cpu'&&p.mpn&&p.attributes?.['Модель']&&new RegExp('\\b'+p.attributes['Модель'].replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\b','i').test(name));if(p){seen.add(url);links.push({mpn:p.mpn,store:'COMPDAY',url})}}}catch(e){console.log('COMPDAY discovery',String(e))}
const blocked=new Map<StoreId,string>();
async function linkWorker(){while(links.length){const link=links.shift()!;const ps=data.products.filter(p=>normalize(p.mpn)===normalize(link.mpn));if(!ps.length)continue;let offer:Offer;try{if(blocked.has(link.store))throw new Error(blocked.get(link.store));const html=await fetchHtml(link.url);if(!matchesMpn(html,link.mpn))throw new Error('Точный MPN не подтверждён');offer={...parseOffer(html,link.store,link.url),identity:'mpn'};report.push({store:link.store,url:link.url,status:'ok',matched:ps.length});console.log(link.store,offer.price,ps[0].name)}catch(e){const error=String(e);if(/HTTP (401|403|429)/.test(error))blocked.set(link.store,error);report.push({store:link.store,url:link.url,status:'error',error});console.log(link.store,error);if(!link.referenceVerified)continue;offer={store:link.store,url:link.url,price:null,availability:'unknown',status:'error',checkedAt:new Date().toISOString(),identity:'verified-reference',error:/HTTP (401|403|429)/.test(error)?'Источник ограничил серверный доступ. Цена не подтверждена.':'Цена не получена; проверь карточку магазина.'}}for(const p of ps)attach(p,offer)}}
await linkWorker();
const now=new Date().toISOString();
const unavailable:Record<string,string>={ONLINETRADE:'Проверена главная страница: вместо каталога возвращается служебная страница проверки. Цены не импортированы.',NIX:'Каталог перенаправляет на страницу ограничения доступа vpnerr.html. Цены не импортированы.',FCENTER:'Проверенный запрос к сайту вернул HTTP 503. Цены не импортированы.'};
data.sources=stores.map(store=>{const offers=data.products.flatMap(p=>p.offers.filter(o=>o.store===store.id));const priced=offers.filter(o=>o.status==='ok'&&o.price!==null);const failed=offers.length-priced.length;return{name:store.id,url:store.url,checkedAt:now,status:priced.length?(failed||report.some(r=>r.store===store.id&&r.status==='error')?'partial':'ok'):offers.length?'limited':unavailable[store.id]?'unavailable':'unavailable',note:store.id==='XCOM'?'352 товара в восьми категориях. Импорт двух первых страниц каждой категории.':store.id==='KNS'?'Дополнительные предложения четырёх процессоров, совпадение по MPN.':priced.length?`${priced.length} точных совпадений по артикулу. ${store.id==='REGARD'?'Успешно прочитаны страницы CPU, GPU, RAM и SSD; другие запросы ограничены HTTP 429. Регион — Москва.':store.id==='COMPDAY'?'Предложения CPU; цена со скидкой, условия оплаты указаны в карточке.':'Москва; предзаказ не считается наличием.'}`:offers.length?'Карточки товаров найдены, но получить достоверную цену серверу не удалось. Ссылки доступны; в итоговой стоимости цены не используются.':unavailable[store.id]||'Не удалось получить подтверждённые цены.'}});
await writeFile('data/catalog.json',JSON.stringify(data,null,2));await writeFile('data/retailer-sync-report.json',JSON.stringify({checkedAt:now,report},null,2));console.log('SUMMARY',JSON.stringify(data.sources.map(s=>({store:s.name,status:s.status,prices:data.products.flatMap(p=>p.offers).filter(o=>o.store===s.name&&o.status==='ok').length}))));
