import {isAllowedStoreUrl} from '../lib/stores.ts';
import {test} from 'node:test';import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {parseOffer,parseXcomCatalog,readSpecs,parseDetails,matchesMpn} from '../lib/providers.mts';
import {checkCompatibility,bestOffer,isCompatibleCandidate} from '../lib/catalog.ts';
import type {Product,Offer} from '../lib/catalog-types';
const rawOffer=(price:string,currency='RUB',stock='InStock')=>`<div itemscope itemtype="https://schema.org/Product"><meta itemprop="name" content="CPU"><div itemprop="offers" itemtype="https://schema.org/Offer"><meta itemprop="priceCurrency" content="${currency}"><meta itemprop="price" content="${price}"><meta itemprop="availability" content="${stock}"></div></div>`;
test('reads price from primary offer, never recommendation or monthly payment',()=>{const s='<span>Платёж 999 ₽</span>'+rawOffer('21490')+rawOffer('500');assert.equal(parseOffer(s,'KNS','https://www.kns.ru/').price,21490)});
test('missing primary price does not pick a recommendation',()=>{assert.throws(()=>parseOffer(rawOffer('')+rawOffer('1234'),'XCOM','https://www.xcom-shop.ru/'));});
test('rejects wrong currency and non-number',()=>{for(const s of [rawOffer('200','USD'),rawOffer('NaN'),rawOffer('-5')])assert.throws(()=>parseOffer(s,'XCOM','https://www.xcom-shop.ru/'));});
test('out-of-stock offer is excluded from a build total',()=>{const p={offers:[parseOffer(rawOffer('20000','RUB','OutOfStock'),'XCOM','https://www.xcom-shop.ru/')]} as Product;assert.equal(bestOffer(p),undefined)});
const item=(id:string,category:Product['category'],specs:Product['specs']):Product=>({id,category,name:id,brand:'',mpn:'',image:'',description:'',offers:[],specs});
test('detects socket, RAM and GPU power conflicts',()=>{const products=[item('cpu','cpu',{socket:'AM5'}),item('board','motherboard',{socket:'LGA1700',memory:'DDR4'}),item('ram','ram',{memory:'DDR5'}),item('gpu','gpu',{recommendedPsu:750}),item('psu','psu',{watts:500})];const errors=checkCompatibility({cpu:'cpu',motherboard:'board',ram:'ram',gpu:'gpu',psu:'psu'},products).filter(i=>i.level==='error');assert.equal(errors.length,3)});
test('compatible candidate does not inherit unrelated existing errors',()=>{const products=[item('cpu','cpu',{socket:'AM5'}),item('bad-board','motherboard',{socket:'LGA1700'}),item('ssd','ssd',{capacity:1000})];assert.equal(isCompatibleCandidate(products[2],{cpu:'cpu',motherboard:'bad-board'},products),true)});
test('unknown dimensions produce warning, never full compatibility',()=>{const products=[item('gpu','gpu',{}),item('case','case',{})];assert.ok(checkCompatibility({gpu:'gpu',case:'case'},products).some(i=>i.level==='warning'))});
test('listing importer keeps MPN and real data-price, not crossed-out price',()=>{const html='<div class="catalog_item catalog_item--list" data-id="1" data-vendor="AMD" data-price="12545"><a class="catalog_item__name" href="/cpu_1.html" title="Процессор AMD Ryzen 5 7500F, AM5 [100-000000597]">CPU</a><div class="catalog_item__old_price">15000</div><div data-level="4"></div></div>';const [p]=parseXcomCatalog(html,'cpu');assert.equal(p.offers[0].price,12545);assert.equal(p.mpn,'100-000000597');assert.equal(p.specs.socket,'AM5')});
test('imported catalog has traceable prices, unique IDs and ten categories',()=>{const d=JSON.parse(readFileSync('data/catalog.json','utf8'));assert.ok(d.products.length>=1500);assert.equal(new Set(d.products.map((p:Product)=>p.id)).size,d.products.length);assert.equal(new Set(d.products.map((p:Product)=>p.category)).size,10);for(const p of d.products){assert.ok(p.offers.length);for(const o of p.offers){assert.ok(isAllowedStoreUrl(o.url,o.store));assert.ok(Number.isFinite(Date.parse(o.checkedAt)));if(o.status==='ok')assert.ok(o.price>0)}}});

test('SATA SSD is never marked NVMe because the page mentions NVMe: no',()=>{const p=item('ssd','ssd',{interface:'NVMe'});p.name='1000 ГБ SATA SSD';const html='<li class="card-tabs-props-list-item"><div class="card-tabs-props-list-item__label">Интерфейс</div><div class="card-tabs-props-list-item__value">SATA III</div></li><li class="card-tabs-props-list-item"><div class="card-tabs-props-list-item__label">Поддержка NVMe</div><div class="card-tabs-props-list-item__value">Нет</div></li>';assert.equal(parseDetails(html,p).specs.interface,'SATA')});

test('JSON-LD uses primary product and keeps preorder out of stock',()=>{const html='<script type="application/ld+json">'+JSON.stringify({'@type':'Product',name:'Exact CPU',offers:{'@type':'Offer',price:13700,priceCurrency:'RUB',availability:'https://schema.org/PreOrder'},isSimilarTo:[{'@type':'Product',offers:{price:999}}]})+'</script>';const o=parseOffer(html,'E2E4','https://moscow.e2e4online.ru/');assert.equal(o.price,13700);assert.equal(o.availability,'out-of-stock')});
test('never substitutes a related JSON-LD product if primary offer missing',()=>{const html='<script type="application/ld+json">'+JSON.stringify({'@type':'Product',name:'main',isSimilarTo:[{'@type':'Product',offers:{price:1000,priceCurrency:'RUB'}}]})+'</script>';assert.throws(()=>parseOffer(html,'REGARD','https://www.regard.ru/'))});
test('exact MPN refuses BOX suffix and substring',()=>{assert.equal(matchesMpn('Код: 100-000000597','100-000000597'),true);assert.equal(matchesMpn('Код: 100-000000597BOX','100-000000597'),false);assert.equal(matchesMpn('Код: X100-000000597','100-000000597'),false)});
test('store allowlist rejects wrong merchant, nested attacker hosts and credentials',()=>{assert.equal(isAllowedStoreUrl('https://www.dns-shop.ru/product/test','DNS'),true);assert.equal(isAllowedStoreUrl('https://www.dns-shop.ru.evil.test/product/','DNS'),false);assert.equal(isAllowedStoreUrl('https://www.kns.ru/product/','DNS'),false);assert.equal(isAllowedStoreUrl('https://user:pass@www.dns-shop.ru/product/','DNS'),false)});
test('CompDay price comes from primary card and exposes discount terms',()=>{const html='<article id="pageProductCard" data-price="11410"><h1>CPU</h1>Товар доступен: Сегодня <b class="actual cash price">11410</b><section id="sameCat">Нет в наличии <div data-price="999">Related</div></section></article>';const o=parseOffer(html,'COMPDAY','https://www.compday.ru/');assert.equal(o.price,11410);assert.equal(o.availability,'in-stock');assert.ok(o.condition)});

test('HDD/AIO categories contain actual drives and cooling systems',()=>{const d=JSON.parse(readFileSync('data/catalog.json','utf8'));for(const p of d.products as Product[]){if(p.category==='hdd'){if(p.offers.some(o=>o.store==='DNS')){assert.match(p.name,/жестк|HDD|накопител/i);assert.doesNotMatch(p.name,/кабел|адаптер|креплен|SSD/i)}else{assert.match(p.name+' '+p.description,/SATA/i);assert.doesNotMatch(p.name+' '+p.description,/SAS|SSD|SCSI|USB/i)}}if(p.category==='aio')assert.ok(/жидкост|водян|СЖО/i.test(p.name)||(/Система охлаждения/i.test(p.name)&&Boolean(p.attributes?.['Размер радиатора'])),p.name)}});

test('корпус без maxGpuLength даёт предупреждение',()=>{assert.ok(checkCompatibility({gpu:'g',case:'c'},[item('g','gpu',{gpuLength:300}),item('c','case',{})]).some(x=>x.level==='warning'&&/Длина видеокарты/.test(x.text)))});
test('БП меньше рекомендованного даёт ошибку',()=>{assert.ok(checkCompatibility({gpu:'g',psu:'p'},[item('g','gpu',{recommendedPsu:850}),item('p','psu',{watts:650})]).some(x=>x.level==='error'))});
test('SAS HDD даёт ошибку',()=>{assert.ok(checkCompatibility({hdd:'h'},[item('h','hdd',{interface:'SAS'})]).some(x=>x.level==='error'))});
test('несовпадение сокетов даёт ошибку',()=>{assert.ok(checkCompatibility({cpu:'p',motherboard:'m'},[item('p','cpu',{socket:'AM5'}),item('m','motherboard',{socket:'AM4'})]).some(x=>x.level==='error'))});
test('серверная память даёт ошибку',()=>{const r=item('r','ram',{moduleType:'RDIMM'});assert.ok(checkCompatibility({ram:'r'},[r]).some(x=>x.level==='error'))});
test('неизвестный TDP не подменяется watts; явный TDP учитывает запас 30%',()=>{const ps=[item('c','cpu',{watts:100}),item('g','gpu',{watts:300}),item('p','psu',{watts:500})];assert.ok(checkCompatibility({cpu:'c',gpu:'g',psu:'p'},ps).some(x=>x.text==='Суммарная мощность не рассчитана: нет данных TDP'));ps[0].specs.tdp=100;ps[1].specs.tdp=300;assert.ok(checkCompatibility({cpu:'c',gpu:'g',psu:'p'},ps).some(x=>x.level==='error'&&/520 Вт/.test(x.text)))});

test('серверный фильтр распознаёт память, SAS и ценовой порог',async()=>{const {isEnterpriseProduct,ENTERPRISE_PRICE_THRESHOLD}=await import('../lib/catalog.ts');assert.equal(isEnterpriseProduct(item('r','ram',{moduleType:'RDIMM'})),true);assert.equal(isEnterpriseProduct(item('h','hdd',{interface:'SAS'})),true);const p=item('p','gpu',{});p.offers=[{store:'XCOM',url:'https://www.xcom-shop.ru/',price:ENTERPRISE_PRICE_THRESHOLD+1,status:'ok',availability:'unknown',checkedAt:'2026-11-02T00:00:00Z'}];assert.equal(isEnterpriseProduct(p),true);p.offers[0].price=ENTERPRISE_PRICE_THRESHOLD;assert.equal(isEnterpriseProduct(p),false)});
