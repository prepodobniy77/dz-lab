import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
import {oldestPriceSelection} from '../lib/hourly-prices.ts';import type {Product} from '../lib/catalog-types';import {xcomJobs} from '../lib/price-cycle-data.ts';
const product=(id:string,checkedAt?:string):Product=>({id,category:'cpu',name:id,brand:'',mpn:'',description:'',image:'',specs:{},offers:checkedAt?[{store:'XCOM',status:'ok',availability:'in-stock',price:1000,url:'https://www.xcom-shop.ru/p.html',checkedAt}]:[]});
test('без цены идут первыми, затем самые старые подтверждённые цены',()=>{const items=[product('fresh','2026-11-02T12:00Z'),product('old','2026-10-01T12:00Z'),product('missing')];assert.deepEqual(oldestPriceSelection(items,30).map(p=>p.id),['missing','old','fresh'])});
test('весь каталог получает попытку проверки без голодания постоянно недоступных товаров',()=>{const products:Product[]=JSON.parse(readFileSync('data/catalog.json','utf8')).products;const attempted=new Set<string>();for(let i=0;i<products.length;i++){const chosen=oldestPriceSelection(products,50,[...attempted]);for(const p of chosen)attempted.add(p.id);if(attempted.size===products.length)break;assert.ok(chosen.length)}assert.equal(attempted.size,products.length)});
test('после полного цикла выбор начинается снова; проверка не подделывает checkedAt',()=>{const items=[product('a','2026-10-01T12:00Z'),product('b')];const before=JSON.stringify(items);assert.equal(oldestPriceSelection(items,50,['a','b']).length,2);assert.equal(JSON.stringify(items),before)});
test('массовый XCOM использует только обычную пагинацию без запрещённых сортировок',()=>{const jobs=xcomJobs();assert.equal(jobs.length,60);assert.equal(new Set(jobs.slice(0,10).map(j=>j.category)).size,10);assert.ok(jobs.every(j=>!j.url.includes('sort=')))});
