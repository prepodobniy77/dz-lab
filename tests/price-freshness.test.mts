import {test} from 'node:test';import assert from 'node:assert/strict';import {bestOffer} from '../lib/catalog.ts';import {priceAgeHours,priceAgeLabel} from '../lib/price-freshness.ts';import {publicSweepReport} from '../lib/price-status.ts';import type {Product,Offer} from '../lib/catalog-types';import type {SweepReport} from '../lib/hourly-prices.ts';
const now=Date.parse('2026-11-03T12:00Z');const offer=(age:number,price=1000)=>({store:'XCOM',price,status:'ok',availability:'in-stock',checkedAt:new Date(now-age*3600000).toISOString(),url:'https://www.xcom-shop.ru/p.html'}) as Offer;
test('давность вычисляется без изменения исходной даты',()=>{const old=offer(37);const date=old.checkedAt;assert.equal(priceAgeHours(old,now),37);assert.equal(priceAgeLabel(old,now),'Обновлено 37 ч назад');assert.equal(old.checkedAt,date)});
test('предложение старше 72 часов уступает свежему, даже если дешевле',()=>{const old=offer(73,100),fresh=offer(1,1000);assert.equal(bestOffer({offers:[old,fresh]} as Product,now),fresh);assert.equal(bestOffer({offers:[old]} as Product,now),old)});
test('публичный отчёт исключает конфигурацию, причины и категории',()=>{const report={checkedAt:'2026-11-03T03:00Z',status:'failed',attempted:1,updated:0,message:'secret',categories:{cpu:{attempted:1,updated:0}},configuration:{key:'secret'}} as unknown as SweepReport;const result=publicSweepReport(report,null)!;assert.deepEqual(Object.keys(result).sort(),['attempted','checkedAt','lastSuccessfulAt','status','updated']);assert.equal(JSON.stringify(result).includes('secret'),false)});
