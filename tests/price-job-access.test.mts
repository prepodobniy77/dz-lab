import {test} from 'node:test';import assert from 'node:assert/strict';import {canRunPriceJob} from '../lib/price-job-access.ts';
test('paid MCP writer requires configured owner and both verified identity fields',()=>{assert.equal(canRunPriceJob('owner@example.test','verified-id','OWNER@example.test'),true);assert.equal(canRunPriceJob('owner@example.test','another-user','other@example.test'),false);assert.equal(canRunPriceJob('', 'id','owner@example.test'),false);assert.equal(canRunPriceJob('owner@example.test',null,'owner@example.test'),false);assert.equal(canRunPriceJob('owner@example.test','id',null),false)});
