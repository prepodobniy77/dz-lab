import {test} from 'node:test';import assert from 'node:assert/strict';import {createRequire} from 'node:module';import {readFileSync} from 'node:fs';
import {saveSweepReport} from '../lib/price-report-store.ts';
import {runPricePortion,type CycleServices} from '../lib/price-cycle.ts';import {offerWriteStatements} from '../lib/offer-storage.ts';import {robotsPolicy} from '../lib/robots-policy.ts';import {stagePrice,matchXcomProduct,coverageAccepted} from '../lib/price-cycle-data.ts';import type {Product} from '../lib/catalog-types';
const products:Product[]=Array.from({length:4},(_,i)=>({id:'xcom-'+(i+1),category:'cpu',name:'Название',brand:'',mpn:'',image:'',description:'',specs:{},offers:[{store:'XCOM',url:`https://www.xcom-shop.ru/part_${i+1}.html`,price:1000,status:'ok',availability:'in-stock',checkedAt:'2026-10-01T00:00:00Z'}]}));
const listing=(count=4,price=1100)=>products.slice(0,count).map((p,i)=>`<div class="catalog_item item" data-id="${i+1}" data-price="${price}"><a class="catalog_item__name" href="${p.offers[0].url}" title="Название">Название</a><span data-level="1"></span></div>`).join('');
async function setup(){const require=createRequire(import.meta.url);const {Miniflare}=createRequire(require.resolve('wrangler/package.json'))('miniflare');const mf=new Miniflare({modules:true,script:'export default {fetch(){return new Response()}}',d1Databases:['DB']});const db=await mf.getD1Database('DB') as D1Database;const sql=readFileSync('drizzle/0000_mushy_albert_cleary.sql','utf8')+'\n--> statement-breakpoint\n'+readFileSync('drizzle/0001_classy_sugar_man.sql','utf8');await db.batch(sql.split('--> statement-breakpoint').filter(s=>s.trim()).map(s=>db.prepare(s)));return{db,dispose:()=>mf.dispose()}}
function services(db:D1Database,body=listing()){let clock=Date.parse('2026-11-03T03:00Z');const delays:number[]=[];return{db,products,config:{},now:()=>clock,pause:async(ms:number)=>{assert.ok(ms>=500);delays.push(ms);clock+=ms},read:async(url:string)=>url.endsWith('/robots.txt')?'User-agent: *\nDisallow: /*?\nAllow: /*?catalog=page-':body,offerStatements:values=>offerWriteStatements(db,values),onReport:async(_report,_final)=>{},delays} satisfies CycleServices&{delays:number[]}}
test('robots учитывает наиболее точное правило и запрещает сортировки',()=>{const policy=robotsPolicy('User-agent: *\nDisallow: /*?\nAllow: /*?catalog=page-\nCrawl-delay: 2');assert.equal(policy.allows('https://www.xcom-shop.ru/catalog/?catalog=page-2'),true);assert.equal(policy.allows('https://www.xcom-shop.ru/catalog/?sort=p'),false);assert.equal(policy.delayMs,2000)});
test('совпадение по названию не допускается; неверные и резко изменившиеся цены задерживаются',()=>{assert.equal(matchXcomProduct({...products[0],id:'other',offers:[{...products[0].offers[0],url:'https://www.xcom-shop.ru/other.html'}]},products),undefined);for(const price of [0,-1,NaN])assert.equal(stagePrice(products[0],{...products[0].offers[0],price}),null);assert.equal(stagePrice(products[0],{...products[0].offers[0],price:1501})?.review,true);assert.equal(stagePrice(products[0],{...products[0].offers[0],price:1500})?.review,false);assert.equal(coverageAccepted(79,100),false)});
test('порции возобновляются из D1, аренда освобождается, публикация только после проверки охвата',async()=>{const {db,dispose}=await setup();try{const s=services(db);let result=await runPricePortion(s);assert.equal(result.done,false);assert.equal((await db.prepare('SELECT count(*) AS n FROM price_offers').first<{n:number}>())!.n,0);const first=result.cursor!.index;result=await runPricePortion(s);assert.ok(result.cursor!.index>first);for(let i=0;i<30&&!result.done;i++)result=await runPricePortion(s);assert.equal(result.done,true);assert.equal(result.report.updated,4);assert.equal((await db.prepare('SELECT count(*) AS n FROM price_offers').first<{n:number}>())!.n,4);assert.ok(s.delays.every(d=>d>=500));const lease=await db.prepare("SELECT blocked_until FROM source_health WHERE store='PRICE_CYCLE_LEASE'").first<{blocked_until:string|null}>();assert.equal(lease?.blocked_until,null)}finally{await dispose()}});
test('охват ниже 80% не публикует ни цен, ни истории',async()=>{const {db,dispose}=await setup();try{const s=services(db,listing(2));let result=await runPricePortion(s);for(let i=0;i<30&&!result.done;i++)result=await runPricePortion(s);assert.equal(result.report.status,'failed');assert.equal((await db.prepare('SELECT count(*) AS n FROM price_offers').first<{n:number}>())!.n,0);assert.equal((await db.prepare('SELECT count(*) AS n FROM price_history').first<{n:number}>())!.n,0)}finally{await dispose()}});
test('изменения более 50% остаются в очереди проверки',async()=>{const {db,dispose}=await setup();try{const s=services(db,listing(4,1600));let result=await runPricePortion(s);for(let i=0;i<30&&!result.done;i++)result=await runPricePortion(s);assert.equal(result.report.pendingReviews,4);assert.equal((await db.prepare('SELECT count(*) AS n FROM price_offers').first<{n:number}>())!.n,0)}finally{await dispose()}});

test('второй исполнитель пропускает успешный цикл, интервал 11 часов отделён от аренды',async()=>{const {db,dispose}=await setup();try{const s=services(db);s.onReport=async(report,final)=>saveSweepReport(db,report,final);let result=await runPricePortion(s);for(let i=0;i<30&&!result.done;i++)result=await runPricePortion(s);const second=await runPricePortion(s,'github');assert.equal(second.skipped,true);const time=s.now();s.now=()=>time+7*3600000;await assert.rejects(runPricePortion(s),e=>(e as {retryAfter:number}).retryAfter>3*3600)}finally{await dispose()}});
test('два параллельных исполнителя не получают одну аренду',async()=>{const {db,dispose}=await setup();let release:()=>void=()=>{};let entered:()=>void=()=>{};const blocked=new Promise<void>(resolve=>{release=resolve});const ready=new Promise<void>(resolve=>{entered=resolve});try{const s=services(db);const read=s.read;let first=true;s.read=async url=>{if(first){first=false;entered();await blocked}return read(url)};const running=runPricePortion(s);await ready;await assert.rejects(runPricePortion(s));release();await running;const next=await runPricePortion(s);assert.equal(next.done,false)}finally{release();await dispose()}});
test('ошибка транзакции публикации не продвигает курсор и позволяет продолжить',async()=>{const {db,dispose}=await setup();try{const s=services(db);s.offerStatements=()=>[db.prepare('INSERT INTO missing_table(value) VALUES(1)')];let failed=false;for(let i=0;i<30;i++){try{await runPricePortion(s)}catch{failed=true;break}}assert.equal(failed,true);const row=await db.prepare("SELECT error FROM source_health WHERE store='PRICE_CYCLE_STATE'").first<{error:string}>();assert.equal(JSON.parse(row!.error).publishOffset,0);assert.equal((await db.prepare('SELECT count(*) AS n FROM price_offers').first<{n:number}>())!.n,0);s.offerStatements=values=>offerWriteStatements(db,values);let result=await runPricePortion(s);for(let i=0;i<10&&!result.done;i++)result=await runPricePortion(s);assert.equal(result.report.updated,4)}finally{await dispose()}});

test('платный лимит 50 общий на все порции, не возобновляется на каждом вызове',async()=>{const {db,dispose}=await setup();try{const s=services(db);await runPricePortion(s);const saved=await db.prepare("SELECT error FROM source_health WHERE store='PRICE_CYCLE_STATE'").first<{error:string}>();const state=JSON.parse(saved!.error);const names=['cpu','motherboard','gpu','ram','ssd','hdd','aio','psu','cooler','case'] as const;const many=Array.from({length:60},(_,i)=>({...products[0],id:'xcom-test-'+i,category:names[i%10]}));state.phase='ai';state.expected=60;state.seen=many.map(p=>p.id);state.staged={};state.updatedIds=[];state.aiAttempted=[];state.aiVisited=[];s.products=many;let charged=0,calls=0;const run:CycleServices={...s,search:async batch=>{charged+=batch.length;calls++;return[]}};await db.batch([db.prepare("UPDATE source_health SET error=? WHERE store='PRICE_CYCLE_STATE'").bind(JSON.stringify(state))]);let result=await runPricePortion(run);for(let i=0;i<10&&!result.done;i++)result=await runPricePortion(run);assert.equal(result.done,true);assert.equal(charged,50);assert.equal(calls,10);assert.equal(result.report.aiProducts,50)}finally{await dispose()}});
test('403 на robots останавливает обход без чтения каталога и публикации',async()=>{const {db,dispose}=await setup();try{const s=services(db);let reads=0;s.read=async()=>{reads++;throw new Error('Магазин вернул HTTP 403')};const result=await runPricePortion(s);assert.equal(result.done,true);assert.equal(result.report.status,'partial');assert.equal(reads,1);assert.equal(result.report.updated,0);assert.equal((await db.prepare('SELECT count(*) AS n FROM price_offers').first<{n:number}>())!.n,0)}finally{await dispose()}});

test('прайс API публикуется даже при блокировке XCOM; повтор порции его не дублирует',async()=>{
 const {db,dispose}=await setup();try{
  const s:CycleServices=services(db);let calls=0;
  s.read=async()=>{throw new Error('HTTP 403')};
  s.bulk=async()=>{calls++;return [{productId:products[0].id,offer:{...products[0].offers[0],store:'DELECT',price:1200,checkedAt:new Date(s.now!()).toISOString()}}]};
  s.onReport=(report,final)=>saveSweepReport(db,report,final);
  const result=await runPricePortion(s,'cron');assert.equal(result.done,true);assert.equal(result.report.updated,1);
  assert.equal((await db.prepare("SELECT count(*) n FROM price_offers WHERE store='DELECT'").first<{n:number}>())!.n,1);
  assert.ok(await db.prepare("SELECT store FROM source_health WHERE store='PRICE_SOURCE_SUCCESS:DELECT'").first());
  assert.equal(await db.prepare("SELECT store FROM source_health WHERE store='PRICE_SOURCE_SUCCESS:XCOM'").first(),null);
  assert.equal(calls,1);
 }finally{await dispose()}
});
test('интервал XCOM не пропускает независимый прайс API',async()=>{
 const {db,dispose}=await setup();try{
  const s:CycleServices=services(db);const date=new Date(s.now!()-13*3600000).toISOString();
  await db.prepare('INSERT INTO source_health(store,checked_at,error) VALUES(?,?,?)').bind('PRICE_SOURCE_SUCCESS:XCOM',date,JSON.stringify({checkedAt:date})).run();
  s.config.PRICE_XCOM_INTERVAL_HOURS='24';let reads=0;s.read=async()=>{reads++;throw new Error('Unexpected HTML request')};
  s.bulk=async()=>[{productId:products[0].id,offer:{...products[0].offers[0],store:'DELECT',price:1200,checkedAt:new Date(s.now!()).toISOString()}}];
  const result=await runPricePortion(s,'cron');assert.equal(result.done,true);assert.equal(result.report.updated,1);assert.equal(reads,0);
 }finally{await dispose()}
});
