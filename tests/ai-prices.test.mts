import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
import {parsePriceLinks,findPriceLinks} from '../lib/ai-price-search.mts';import {oldestPriceSelection} from '../lib/hourly-prices.ts';import type {Product} from '../lib/catalog-types';
const product={id:'p',mpn:'ABC-123',offers:[{store:'XCOM',url:'https://www.xcom-shop.ru/part.html'}]} as Product;const url=product.offers[0].url;
const response=(links:unknown[],citations=[url])=>({status:'completed',output:[{type:'message',content:[{type:'output_text',text:JSON.stringify({links}),annotations:citations.map(url=>({type:'url_citation',url}))}]}]});
test('AI accepts a cited exact part link but never an invented price',()=>{const links=parsePriceLinks(response([{productId:'p',mpn:'ABC-123',url,price:1}]),[product]);assert.equal(links.length,1);assert.equal('price' in links[0],false)});
test('AI rejects missing citations, wrong part, unknown item and attacker URLs',()=>{for(const link of [{productId:'p',mpn:'ABC-123BOX',url},{productId:'other',mpn:'ABC-123',url},{productId:'p',mpn:'ABC-123',url:'https://www.xcom-shop.ru.evil.test/p'}])assert.equal(parsePriceLinks(response([link]),[product]).length,0);assert.equal(parsePriceLinks(response([{productId:'p',mpn:'ABC-123',url}],[]),[product]).length,0)});
test('without MPN, AI can only return an existing verified product URL',()=>{const p={...product,mpn:''};assert.equal(parsePriceLinks(response([{productId:'p',mpn:'',url}]),[p]).length,1);const other='https://www.xcom-shop.ru/other.html';assert.equal(parsePriceLinks(response([{productId:'p',mpn:'',url:other}],[other]),[p]).length,0)});
test('no AI key causes no outgoing network request',async()=>{let called=false;await assert.rejects(findPriceLinks([product],'',undefined,async()=>{called=true;return new Response()}));assert.equal(called,false)});
test('выбор старых цен ограничен квотами всех десяти категорий',()=>{const products:Product[]=JSON.parse(readFileSync('data/catalog.json','utf8')).products;const a=oldestPriceSelection(products,50);assert.equal(a.length,50);assert.equal(new Set(a.map(p=>p.id)).size,50);assert.equal(new Set(a.map(p=>p.category)).size,10);for(const category of new Set(a.map(p=>p.category)))assert.equal(a.filter(p=>p.category===category).length,5)});
