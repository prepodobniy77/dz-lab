import {test} from 'node:test';import assert from 'node:assert/strict';
import {findRouterAIPriceLinks,parseRouterAIPriceLinks} from '../lib/routerai-price-search.mts';import type {Product} from '../lib/catalog-types';
const url='https://www.xcom-shop.ru/exact.html';const products=[{id:'p',name:'Exact CPU',mpn:'EXACT-1',offers:[]} as unknown as Product];
const payload=(finish='stop',cited=true)=>({choices:[{finish_reason:finish,message:{content:JSON.stringify({links:[{productId:'p',mpn:'EXACT-1',url}]}),annotations:cited?[{type:'url_citation',url_citation:{url}}]:[]}}]});
test('RouterAI normalizes nested URL citations and preserves exact MPN validation',()=>{assert.equal(parseRouterAIPriceLinks(payload(),products)[0].url,url);assert.equal(parseRouterAIPriceLinks(payload('stop',false),products).length,0);const wrong=payload();wrong.choices[0].message.content=JSON.stringify({links:[{productId:'p',mpn:'EXACT-1BOX',url}]});assert.equal(parseRouterAIPriceLinks(wrong,products).length,0)});
test('truncated or unfinished RouterAI responses never become observations',()=>{assert.throws(()=>parseRouterAIPriceLinks(payload('length'),products));assert.throws(()=>parseRouterAIPriceLinks({error:{message:'bad'}},products))});
test('RouterAI request targets the user-selected service with an explicit bounded web plugin',async()=>{let calls=0;await findRouterAIPriceLinks(products,'test-key',undefined,async(endpoint,init)=>{calls++;assert.equal(endpoint,'https://routerai.ru/api/v1/chat/completions');assert.equal(init?.redirect,'manual');const body=JSON.parse(init?.body as string);assert.equal(body.model,'z-ai/glm-5.3-flash');assert.equal(body.plugins[0].id,'web');assert.equal(body.plugins[0].engine,'exa');assert.equal(body.plugins[0].max_results,3);assert.ok(body.plugins[0].include_domains.includes('www.dns-shop.ru'));assert.equal(body.stream,false);return new Response(JSON.stringify(payload()),{headers:{'content-type':'application/json'}})});assert.equal(calls,1)});
test('missing RouterAI key makes no outgoing request',async()=>{let called=false;await assert.rejects(findRouterAIPriceLinks(products,'',undefined,async()=>{called=true;return new Response()}));assert.equal(called,false)});
test('RouterAI HTTP errors do not leak a provider response body or API credentials',async()=>{await assert.rejects(findRouterAIPriceLinks(products,'never-print-this',undefined,async()=>new Response('secret response body',{status:401})),/^Error: RouterAI: HTTP 401$/)});

test('trailing whitespace in a cited model URL is normalized safely',()=>{const v=payload();v.choices[0].message.content=JSON.stringify({links:[{productId:'p',mpn:'EXACT-1',url:url+'  '}]});assert.equal(parseRouterAIPriceLinks(v,products)[0].url,url)});
