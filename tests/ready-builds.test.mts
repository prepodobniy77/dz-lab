import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
import {checkCompatibility,bestOffer} from '../lib/catalog.ts';import type {Product,Selection} from '../lib/catalog-types';
const products:Product[]=JSON.parse(readFileSync('data/catalog.json','utf8')).products;
const builds:{id:string;group:string;integratedGraphics:boolean;selection:Selection}[]=JSON.parse(readFileSync('data/ready-builds.json','utf8'));
test('twenty distinct configurations cover every intended use',()=>{assert.equal(builds.length,20);assert.equal(new Set(builds.map(b=>b.id)).size,20);assert.equal(new Set(builds.map(b=>JSON.stringify(b.selection))).size,20);assert.deepEqual([...new Set(builds.map(b=>b.group))].sort(),['budget','gaming','office','premium','work'])});
test('every template references actual products in correct slots and all essential parts',()=>{for(const b of builds){for(const slot of ['cpu','motherboard','ram','ssd','psu','case'] as const)assert.ok(b.selection[slot],`${b.id} lacks ${slot}`);assert.ok(!!b.selection.cooler!==!!b.selection.aio);for(const [slot,id] of Object.entries(b.selection)){const p=products.find(p=>p.id===id);assert.equal(p?.category,slot);assert.ok(p&&bestOffer(p),`${b.id} missing source price`)}}});
test('no template has detected socket, DDR, dimensions or power conflict',()=>{for(const b of builds)assert.deepEqual(checkCompatibility(b.selection,products).filter(x=>x.level==='error'),[],b.id)});
test('templates without a GPU explicitly use a CPU with integrated graphics',()=>{for(const b of builds){assert.equal(!b.selection.gpu,b.integratedGraphics);if(b.integratedGraphics){const cpu=products.find(p=>p.id===b.selection.cpu)!;assert.match(cpu.name,/5600GT|5700G|8600G|i5-12400$/)}}});
test('storage and liquid-cooling configurations are included, prices span cheap and flagship',()=>{assert.ok(builds.some(b=>b.selection.hdd));assert.ok(builds.some(b=>b.selection.aio));const prices=builds.map(b=>Object.values(b.selection).reduce((sum,id)=>sum+bestOffer(products.find(p=>p.id===id)!)!.price!,0));assert.ok(Math.min(...prices)<60000);assert.ok(Math.max(...prices)>500000)});
