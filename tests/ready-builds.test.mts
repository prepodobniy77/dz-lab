import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
import {checkCompatibility,bestOffer} from '../lib/catalog.ts';import type {Product,Selection} from '../lib/catalog-types';
const products:Product[]=JSON.parse(readFileSync('data/catalog.json','utf8')).products;
import {readyBuildOverview,type ReadyBuild} from '../lib/ready-builds.ts';
import {isAllowedStoreUrl} from '../lib/stores.ts';
const builds:ReadyBuild[]=JSON.parse(readFileSync('data/ready-builds.json','utf8'));
const templates=builds.filter(b=>!b.retail);
const retail=builds.filter(b=>b.retail);
test('twenty choices retain sixteen editable templates and add four distinct DNS PCs',()=>{assert.equal(builds.length,20);assert.equal(new Set(builds.map(b=>b.id)).size,20);assert.equal(templates.length,16);assert.equal(retail.length,4);assert.equal(new Set(templates.map(b=>JSON.stringify(b.selection))).size,16);assert.equal(new Set(retail.map(b=>b.retail!.url)).size,4);assert.deepEqual([...new Set(builds.map(b=>b.group))].sort(),['budget','gaming','office','premium','work'])});
test('every template references actual products in correct slots and all essential parts',()=>{for(const b of templates){for(const slot of ['cpu','motherboard','ram','ssd','psu','case'] as const)assert.ok(b.selection[slot],`${b.id} lacks ${slot}`);assert.ok(!!b.selection.cooler!==!!b.selection.aio);for(const [slot,id] of Object.entries(b.selection)){const p=products.find(p=>p.id===id);assert.equal(p?.category,slot);assert.ok(p&&bestOffer(p),`${b.id} missing source price`)}}});
test('no template has detected socket, DDR, dimensions or power conflict',()=>{for(const b of templates)assert.deepEqual(checkCompatibility(b.selection,products).filter(x=>x.level==='error'),[],b.id)});
test('templates without a GPU explicitly use a CPU with integrated graphics',()=>{for(const b of templates){assert.equal(!b.selection.gpu,b.integratedGraphics);if(b.integratedGraphics){const cpu=products.find(p=>p.id===b.selection.cpu)!;assert.match(cpu.name,/5600GT|5700G|8600G|i5-12400$/)}}});
test('storage and liquid-cooling configurations are included, prices span cheap and flagship',()=>{assert.ok(builds.some(b=>b.selection.hdd));assert.ok(builds.some(b=>b.selection.aio));const prices=builds.map(b=>readyBuildOverview(b,products).total);assert.ok(Math.min(...prices)<60000);assert.ok(Math.max(...prices)>500000)});

test('DNS PCs use verified whole-computer prices and never fabricated selections',()=>{for(const build of retail){const pc=build.retail!;assert.deepEqual(build.selection,{});assert.ok(isAllowedStoreUrl(pc.url,'DNS'));assert.match(new URL(pc.url).pathname,/^\/product\/[a-f0-9]{16}\/pk-ardor-gaming-/);assert.ok(pc.price>0);assert.equal(pc.currency,'RUB');assert.equal(pc.region,'Москва');assert.ok(Number.isFinite(Date.parse(pc.checkedAt)));for(const field of ['Процессор','Видеокарта','ОЗУ','SSD','ОС'])assert.ok(pc.specs[field]);assert.equal(Number(pc.rawSnippet.replace(/[^\d]/g,'')),pc.price);const overview=readyBuildOverview(build,products);assert.equal(overview.total,pc.price);assert.equal(overview.checkedAt,pc.checkedAt);assert.deepEqual(overview.parts,[]);assert.equal(overview.missing,0);assert.equal(overview.unresolved,0)}});
