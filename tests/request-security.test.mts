import {test} from 'node:test';import assert from 'node:assert/strict';import {readJsonLimited} from '../lib/http-body.ts';import {canAccessPriceJob} from '../lib/price-job-access.ts';import {SweepIntervalError,sweepErrorStatus} from '../lib/price-job-errors.ts';import {fetchPriceExport} from '../lib/price-api.mts';
test('ограничение тела работает без Content-Length, с чанками и многобайтным текстом',async()=>{const data=new TextEncoder().encode(JSON.stringify({text:'я'.repeat(2600)}));const body=new ReadableStream({start(c){c.enqueue(data.slice(0,2000));c.enqueue(data.slice(2000));c.close()}});await assert.rejects(readJsonLimited(new Request('https://test/',{method:'POST',body,duplex:'half'} as RequestInit)),e=>(e as {status:number}).status===413);assert.deepEqual(await readJsonLimited(new Request('https://test/',{method:'POST',body:'{}'})),{});await assert.rejects(readJsonLimited(new Request('https://test/',{method:'POST',body:'{'})),e=>(e as {status:number}).status===400)});
test('заголовки личности отключены по умолчанию, Bearer проверяется независимо',async()=>{const headers=new Headers({'oai-authenticated-user-id':'id','oai-authenticated-user-email':'owner@test'});const config={PRICE_JOB_OWNER_EMAIL:'owner@test',PRICE_JOB_TOKEN:'secret'};assert.equal(await canAccessPriceJob(config,headers),false);assert.equal(await canAccessPriceJob({...config,TRUST_OAI_HEADERS:'1'},headers),true);headers.set('authorization','Bearer secret');assert.equal(await canAccessPriceJob(config,headers),true);headers.set('authorization','Bearer wrong');assert.equal(await canAccessPriceJob(config,headers),false)});
test('429 выдаётся только для защитного интервала',()=>{assert.equal(sweepErrorStatus(new SweepIntervalError()),429);assert.equal(sweepErrorStatus(new Error('база недоступна')),503)});
test('валидация и отказ API не расходуют кулдаун; успешный HTTP старт вызывает его',async()=>{let starts=0,calls=0;const started=async()=>{starts++};await assert.rejects(fetchPriceExport('key','bad/supplier',async()=>{calls++;return new Response()},started));assert.equal(calls,0);assert.equal(starts,0);await assert.rejects(fetchPriceExport('key','Netlab',async()=>new Response('',{status:403}),started));assert.equal(starts,0);await fetchPriceExport('key','Netlab',async()=>new Response('{"_eof":true,"count":0}'),started);assert.equal(starts,1)});
